# Copy to /etc/default/water-monitor for systemd, or export before npm start.
HOST=0.0.0.0
PORT=80
# Fallback path for the LoRa receiver board, used only if no device matches
# SERIAL_VENDOR_ID/SERIAL_PRODUCT_ID below. /dev/water-radio is the stable
# symlink the installer's udev rule creates; prefer it over a bare ttyUSB
# number, which is assigned in boot enumeration order and can land on the pump
# relay instead.
SERIAL_PORT=/dev/water-radio
# USB identity of the receiver board. Default is the Heltec WiFi LoRa 32 V3's
# CP2102 bridge. If your board is a clone with a CH340 (1a86:7523 - the same
# chip as the relay), set these to match it and give the relay a different
# identity, or the two cannot be told apart. Check with:
#   curl -s localhost/api/system/serial-ports
SERIAL_VENDOR_ID=10c4
SERIAL_PRODUCT_ID=ea60
BAUD_RATE=115200
SIMULATE=false
DB_PATH=/opt/water-monitor/water-monitor.sqlite
RETENTION_DAYS=90
PRUNE_INTERVAL_HOURS=12
TREND_MAX_POINTS=300
PUMP_CONTROL_ENABLED=false
PUMP_OUTPUT=gpio
PUMP_GPIO_PIN=17
PUMP_GPIO_ACTIVE_HIGH=true
PUMP_USB_RELAY_PORT=/dev/ttyUSB1
PUMP_USB_RELAY_BAUD=9600
# Optional: lock the relay to its USB vendor/product ID instead of a fixed
# path. Recommended for boards with no serial number, where the OS can
# assign a different /dev path on every reconnect. PUMP_USB_RELAY_PORT
# above is kept as a fallback if no matching device is found.
PUMP_USB_RELAY_VENDOR_ID=
PUMP_USB_RELAY_PRODUCT_ID=
WATCHDOG_INTERVAL_SECONDS=5
WATCHDOG_FAILURE_THRESHOLD=3
# Grace period at watchdog startup only, before an unreachable main app counts
# as a failure. systemd starts both services together at boot, so without this
# the watchdog "rescues" a machine that is merely still booting - forcing the
# saved pump mode to manual_off and pushing an urgent alert on every restart.
# Ends early the moment the main app answers once.
WATCHDOG_STARTUP_GRACE_SECONDS=90
# The watchdog's runtime ceiling tracks the "Max Run Hours" set on the
# dashboard, read from the app's status endpoint, plus the grace margin below.
# Only the elapsed-time measurement is independent (the watchdog's own clock),
# so a logic bug that leaves the pump on without the app crashing still gets
# caught - but the watchdog no longer overrules the operator's setting.
#
# The grace exists so the app's own cleaner stop always runs first and this
# fires only as a true backstop. These used to need hand-matching, and when
# they drifted apart the watchdog cut long fills short at its own fixed limit.
WATCHDOG_RUNTIME_GRACE_MINUTES=20
# Absolute cap regardless of what the app reports, and the value used until the
# app has reported its setting even once.
WATCHDOG_MAX_RUNTIME_MINUTES=1500
WATCHDOG_FALLBACK_RUNTIME_MINUTES=150
# Absolute full level of the tank, in FEET OF WATER ABOVE THE SENSOR TAP - not
# the tank's physical height. The sensor taps in about a foot above the floor,
# so this reads roughly a foot lower than the tank's own gauge. Percent full,
# the tank graphic, the trend axis, and the ceiling on every level threshold
# are all measured against this.
TANK_MAX_FEET=7.2
NTFY_ENABLED=false
# The ntfy server runs on this same Pi (e.g. a Docker container), so this is
# normally 127.0.0.1 or the Pi's own LAN IP, not a separate device. See
# "Notification Settings" in the README for what that does and does not cover.
NTFY_SERVER_URL=http://127.0.0.1:8081
NTFY_TOPIC=camp-ascca-water
NTFY_TOKEN=
