{
  "name": "campsite-water-tower-monitor",
  "version": "1.0.0",
  "description": "Local LAN dashboard for monitoring a campsite water tower from ESP32 LoRa serial readings.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:lowmem": "NODE_OPTIONS=--max-old-space-size=96 node server.js",
    "dev": "SIMULATE=true PORT=8080 node server.js",
    "demo": "PORT=8080 node demo-server.js",
    "check": "node --check server.js"
  },
  "keywords": [
    "raspberry-pi",
    "water-tower",
    "express",
    "sqlite",
    "serial"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@serialport/parser-readline": "^12.0.0",
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2",
    "onoff": "^6.0.3",
    "serialport": "^12.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
